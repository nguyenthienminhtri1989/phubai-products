// File: schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Hoặc "mysql", "sqlserver" tùy bạn chọn
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUM: VAI TRÒ NGƯỜI DÙNG
// ==========================================
enum UserRole {
  ADMIN // Quản trị hệ thống — full quyền
  DIRECTOR // Tổng/Phó Tổng GĐ — xem tất cả, sửa trang được gán
  FACTORY_MANAGER // Giám đốc Nhà máy — xem/sửa NM mình, xem NM khác
  SALES // Phòng Kinh doanh
  PROCESS_LEAD // Trưởng công đoạn
  STATISTICIAN // Người thống kê (nhập liệu sản lượng, điện năng)
  TEAM_LEAD // Tổ trưởng — nhập liệu + xem CĐ mình
  VIEWER // Chỉ xem — mặc định cho user mới
}

// ==========================================
// ENUM: LOẠI LÔ HÀNG
// ==========================================
enum LotType {
  RAW_COTTON // Lô bông (nguyên liệu tự nhiên)
  RAW_FIBER // Lô xơ (nguyên liệu nhân tạo: PE, viscose...)
  YARN // Lô sợi (thành phẩm)
}

enum LotStatus {
  OPEN // Đang sản xuất / đang sử dụng
  CLOSED // Đã đóng lô
  SHIPPED // Đã giao hàng (chỉ dùng cho YARN)
}

// ==========================================
// 1. DANH MỤC NHÀ MÁY (Hierarchy)
// ==========================================

model Factory {
  id   Int     @id @default(autoincrement())
  name String // Tên nhà máy (NM1, NM2...)
  note String? // Ghi chú

  processes       Process[] // 1 Nhà máy có nhiều Công đoạn
  substations     Substation[]
  powerMeters     PowerMeter[]
  productionLines ProductionLine[]

  // KD-SX relations
  salesOrders        SalesOrder[]
  monthlyInputParams MonthlyInputParam[]
  monthlyPlans       MonthlyPlan[]
  monthlyActuals     MonthlyActual[]
  summarySnapshots   MonthlySummarySnapshot[]
  contractOpeningBalances ContractOpeningBalance[]

  // Định mức năng suất
  benchmarkVersions BenchmarkVersion[]

  // Module Kế hoạch SX tháng
  productionSchedules ProductionSchedule[]

  // Monthly quota
  monthlyQuotas MonthlyQuota[]

  // Users assigned to this factory
  users         User[]
  userFactories UserFactory[] // Pivot table cho phân quyền nhiều NM

  // Lot management
  lots Lot[]

  fixedCostEntries FixedCostEntry[]

  @@map("factories")
}

// ==========================================
// 2. CÔNG ĐOẠN
// ==========================================
model Process {
  id   Int    @id @default(autoincrement())
  name String // Tên công đoạn (bông chải, ghép thô...)

  // Đánh dấu công đoạn cuối có SL dùng để tính doanh thu (thường là công đoạn ống).
  // Dashboard v2 (production-matrix, allocation) chỉ tính SL của công đoạn này.
  isRevenueProcess Boolean @default(false)

  factoryId Int
  factory   Factory @relation(fields: [factoryId], references: [id])

  machines      Machine[] // 1 Công đoạn quản lý nhiều Máy
  userProcesses UserProcess[] // Phân quyền: User nào thuộc công đoạn nào

  // Định mức năng suất
  productivityBenchmarks ProductivityBenchmark[]

  // Module Kế hoạch SX tháng
  productionSchedules ProductionSchedule[]

  // Monthly quota
  monthlyQuotas MonthlyQuota[]
  contractOpeningBalances ContractOpeningBalance[]

  @@map("processes")
}

// ==========================================
// 2. DANH MỤC MẶT HÀNG (Items)
// ==========================================

model Item {
  id Int @id @default(autoincrement())

  // Các trường thông tin cơ bản
  name String  @unique // Tên đầy đủ (Không được trùng)
  code String? // Mã viết tắt (nếu cần sau này, tạm để optional)

  // Các thông số kỹ thuật (Optional - Không bắt buộc)
  ne           Int? // Chi số (Số nguyên 3 chữ số)
  composition  String? // Thành phần
  twist        Int? // Độ săn (Số nguyên)
  weavingStyle String? // Kiểu dệt
  material     String? // Nguyên liệu
  yarnType     String  @default("SINGLE") // "SINGLE" = 1 thành phần (chỉ cotton), "BLENDED" = sợi pha (cotton + PE)

  // Quan hệ (Giữ nguyên logic cũ)
  runningOnMachines Machine[] // Đang chạy trên máy nào?
  productionLogs    ProductionLog[] // Lịch sử sản xuất

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productionLines ProductionLine[]
  iotMaps         IotItemMap[]

  // KD-SX relations
  salesOrderItems  SalesOrderItem[]
  rawMaterialRates RawMaterialRate[]
  planLineItems    PlanLineItem[]
  actualLineItems  ActualLineItem[]

  // Định mức năng suất
  productivityBenchmarks ProductivityBenchmark[]

  // KD Daily Input
  kdDailyInputs KdDailyInput[]

  // Module Kế hoạch SX tháng
  scheduleSegments ScheduleSegment[]

  // Multi-item assignments
  machineAssignments MachineItemAssignment[]

  // Lot management
  lots Lot[]

  // Cơ cấu NVL theo tháng
  monthlyMaterials ItemMonthlyMaterial[]

  @@map("items")
}

// ==========================================
// 3. DANH MỤC MÁY MÓC (Machines) - Cấu hình
// ==========================================

model Machine {
  id       Int     @id @default(autoincrement())
  name     String  @unique // Tên máy (Máy 01, Máy 02...)
  isActive Boolean @default(true) // True: Đang dùng, False: Đã thanh lý (Thay máy mới)

  // Loại máy (VD: "G32", "Murata Qpro-EX") — dùng để map tới ProductivityBenchmark
  model String?

  // --- Phân cấp ---
  processId Int
  process   Process @relation(fields: [processId], references: [id])

  // --- Cấu hình tính toán (Quan trọng) ---
  // 1: Nhập thẳng kg
  // 2: (Cuối - Đầu)
  // 3: (Cuối - Đầu) * Số cọc / (Chi số * K)
  // 4: (Cuối - Đầu) / Chi số
  formulaType Int @default(1)

  spindleCount Int? // Số cọc (Chỉ dùng cho FormulaType = 3, máy khác để Null)

  // --- Chế độ chạy nhiều mặt hàng ---
  allowMultiItemPerShift Boolean @default(false)

  // --- Trạng thái hiện tại ---
  currentItemId Int? // Máy đang chạy hàng nào? (Dùng để gợi ý khi nhập liệu)
  currentItem   Item? @relation(fields: [currentItemId], references: [id])

  // 2. Chi số đang chạy là bao nhiêu?
  // Dành cho máy loại 3, 4. 
  // Giá trị này sẽ tự động nhảy vào ô nhập liệu để công nhân đỡ phải gõ.
  currentNE Float?

  // Lô sợi đang sản xuất (optional)
  currentLotId Int?
  currentLot   Lot? @relation("CurrentLot", fields: [currentLotId], references: [id])

  maintenanceTasks MaintenanceTask[]

  // --- Dữ liệu lịch sử ---
  productionLogs ProductionLog[]
  linksFrom      ProductionLineLink[] @relation("LinkFrom")
  linksTo        ProductionLineLink[] @relation("LinkTo")
  stopLogs       MachineStopLog[]
  iotMaps        IotMachineMap[]

  // KD Daily Input
  kdDailyInputs KdDailyInput[]

  // Module Kế hoạch SX tháng
  scheduleSegments ScheduleSegment[]

  // Multi-item assignments
  itemAssignments MachineItemAssignment[]

  @@map("machines")
}

// ==========================================
// 4. NHẬT KÝ SẢN LƯỢNG (Dữ liệu hàng ngày)
// ==========================================

model ProductionLog {
  id Int @id @default(autoincrement())

  // 1. Thông tin Máy & Thời gian
  machineId  Int
  recordDate DateTime @db.Date // Chỉ lưu ngày
  shift      Int // 1, 2, 3

  // 2. Thông tin Mặt hàng (Sửa lỗi quan hệ với Item)
  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  // 3. Chỉ số & Sản lượng
  startIndex  Float? @default(0) // <--- Cột mới thêm
  endIndex    Float?
  inputNE     Float?
  finalOutput Float
  efficiency  Float? // Hiệu suất máy (0–100%), nullable — không bắt buộc

  note String?

  // 4. Quan hệ với User (Sửa lỗi createdLogs trong User)
  // Thêm dòng này để Prisma biết ai là người tạo bản ghi
  createdById Int? // Có thể để null nếu chưa bắt buộc
  createdBy   User? @relation(fields: [createdById], references: [id])

  // 5. Quan hệ với Máy
  machine Machine @relation(fields: [machineId], references: [id])

  // 6. Lô hàng (tự động lấy từ Machine.currentLotId khi nhập)
  lotId Int?
  lot   Lot? @relation(fields: [lotId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique constraint cũ [machineId, recordDate, shift, itemId] đã được thay bằng
  // 2 partial unique index (xem migration shift_item_change_multi_lot):
  //   - prod_log_unique_with_lot: (machineId, recordDate, shift, itemId, lotId) WHERE lotId IS NOT NULL
  //   - prod_log_unique_no_lot:   (machineId, recordDate, shift, itemId)        WHERE lotId IS NULL
  // Prisma chưa hỗ trợ partial unique index nên không khai báo @@unique ở đây.
  // 1. Index cho việc lọc theo khoảng thời gian (quan trọng nhất)
  @@index([recordDate])
  // 2. Index composite: Khi lọc kết hợp Ngày + Máy + Ca (Performance cực cao)
  @@index([recordDate, machineId])
  @@index([machineId, shift])
  @@index([itemId])
  @@index([lotId])
  @@map("production_logs")
}

// ==========================================
// 5. NGƯỜI DÙNG (Quản lý quyền hạn)
// ==========================================

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String // Lưu hash (đã mã hóa)
  fullName String

  // --- PHÂN QUYỀN MỚI ---
  userRole UserRole @default(VIEWER) // Vai trò chính của user

  // Gán nhà máy (cho FACTORY_MANAGER, STATISTICIAN, TEAM_LEAD)
  factoryId Int?
  factory   Factory? @relation(fields: [factoryId], references: [id])

  // --- TRẠNG THÁI ---
  isActive Boolean @default(false) // false: Chờ duyệt, true: Được dùng

  // --- PHẠM VI CÔNG VIỆC ---
  userProcesses   UserProcess[] // User thuộc các công đoạn nào?
  userFactories   UserFactory[] // Gán nhiều nhà máy (cho STATISTICIAN)
  pagePermissions PagePermission[] // Quyền xem/sửa từng trang

  createdLogs   ProductionLog[] // Quan hệ: Ai nhập dòng này?
  createdAt     DateTime         @default(now())
  createdLines  ProductionLine[]
  reportedStops MachineStopLog[]

  // KD Daily Input
  kdDailyInputs KdDailyInput[]

  @@map("users")
}

// Bảng trung gian: User <-> Process (nhiều-nhiều)
model UserProcess {
  userId    Int
  processId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  process   Process @relation(fields: [processId], references: [id])

  @@id([userId, processId])
  @@map("user_processes")
}

// Bảng trung gian: User <-> Factory (nhiều-nhiều)
// Dùng cho STATISTICIAN cần truy cập nhiều nhà máy
model UserFactory {
  userId    Int
  factoryId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  factory   Factory @relation(fields: [factoryId], references: [id])

  @@id([userId, factoryId])
  @@map("user_factories")
}

// Bảng Danh mục Hạng mục bảo dưỡng (Maintenance Task)
// Lưu trữ các cấu hình định kỳ cho từng máy
model MaintenanceTask {
  id String @id @default(cuid())

  // Điều chỉnh machineId thành kiểu Int để khớp với Machine.id
  machineId Int

  taskName          String
  description       String?
  intervalMonths    Float
  lastPerformedDate DateTime?
  nextDueDate       DateTime
  leadTimeDays      Int       @default(30)
  emailNotify       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Thiết lập mối quan hệ chính thức với bảng Machine
  // Lưu ý: Tên field là 'machine', khớp với lệnh include trong API
  machine Machine @relation(fields: [machineId], references: [id])

  history MaintenanceHistory[]

  @@index([machineId])
  @@index([nextDueDate])
  @@map("maintenance_tasks")
}

// Cần bổ sung thêm quan hệ vào bảng Machine để Prisma nhận diện
// (Thêm dòng này vào bên trong model Machine của bạn)
// model Machine {
//   ...
//   maintenanceTasks MaintenanceTask[]
// }

// ==========================================
// BẢNG NHẬT KÝ BẢO DƯỠNG (Maintenance History)
// ==========================================
// Lưu vết mỗi lần thực hiện xong
model MaintenanceHistory {
  id            String   @id @default(cuid())
  taskId        String
  performedDate DateTime @default(now()) // Ngày thực hiện thực tế
  performedBy   String? // Tên công nhân/kỹ thuật viên
  notes         String? // Ghi chú tình trạng lúc đó
  cost          Float?   @default(0)

  // Quan hệ
  task MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([performedDate])
}

// ==========================================
// MODULE QUẢN LÝ ĐIỆN NĂNG (ENERGY MANAGEMENT)
// ==========================================

// 1. Danh mục Giá điện (Có thể chỉnh sửa khi điện lực đổi giá)
model ElectricityPrice {
  id          Int      @id @default(autoincrement())
  type        String   @unique // NORMAL, PEAK, OFF_PEAK
  name        String // Bình thường, Cao điểm, Thấp điểm
  price       Float // Vd: 1833, 3398, 1190
  description String? // Ghi chú khung giờ (Vd: 04:00 - 09:30...)
  updatedAt   DateTime @updatedAt

  @@map("electricity_prices")
}

// ==========================================
// BẢNG DANH MỤC TRẠM BIẾN ÁP (Substation)
// ==========================================
model Substation {
  id   Int    @id @default(autoincrement())
  code String @unique // Mã trạm (Vd: TBA-01)
  name String // Tên trạm (Vd: Trạm biến áp Nhà máy 1)

  // Liên kết với Nhà máy
  factoryId Int
  factory   Factory @relation(fields: [factoryId], references: [id])

  // Quan hệ 1 trạm có nhiều đồng hồ hạ thế
  meters PowerMeter[]

  @@map("substations")
}

// ==========================================
// BẢNG DANH MỤC ĐỒNG HỒ ĐIỆN / CÔNG TƠ (PowerMeter)
// ==========================================
model PowerMeter {
  id          Int     @id @default(autoincrement())
  code        String  @unique // Mã đồng hồ
  name        String // Tên đồng hồ (Vd: Công tơ tổng NM1)
  description String? // Mô tả về đồng hồ

  type     Int     @default(1) // 1: Hạ thế, 2: Trung thế
  tu       Float   @default(1.0)
  ti       Float   @default(1.0)
  isActive Boolean @default(true)

  // ---> CÁC TRƯỜNG PHỤC VỤ IOT BẮT BUỘC PHẢI CÓ
  isAuto   Boolean @default(false) // true: Đọc qua Gateway, false: Nhập tay
  modbusId Int? // Slave ID của đồng hồ (VD: 1, 2...) dùng cho RS485

  // 👇 THÊM 2 TRƯỜNG NÀY 👇
  gatewayIp   String? // Lưu IP (192.168.1.253) hoặc Tên miền DDNS (nhamay3.dyndns.org)
  gatewayPort Int     @default(502) // Cổng Modbus TCP (Thường là 502)

  factoryId Int
  factory   Factory @relation(fields: [factoryId], references: [id])

  substationId Int?
  substation   Substation? @relation(fields: [substationId], references: [id])

  meterGroupId Int?
  meterGroup   MeterGroupCategory? @relation(fields: [meterGroupId], references: [id])

  records     PowerRecord[]
  telemetries PowerTelemetry[] // ---> Liên kết với bảng hứng dữ liệu thô

  @@map("power_meters")
}

// ==========================================
// BẢNG HỨNG DỮ LIỆU IOT LIÊN TỤC (PowerTelemetry)
// ==========================================
model PowerTelemetry {
  id        BigInt   @id @default(autoincrement())
  timestamp DateTime @default(now())

  meterId Int
  meter   PowerMeter @relation(fields: [meterId], references: [id])

  totalEnergy Float? // Tổng kWh (Tương ứng thanh ghi 0x00)
  activePower Float? // Tổng kW (Tương ứng thanh ghi 0x0E mà bạn muốn lấy)

  @@index([timestamp, meterId])
  @@map("power_telemetries")
}

// ==========================================
// BẢNG GHI NHẬN CHỈ SỐ ĐIỆN HÀNG NGÀY (PowerRecord)
// ==========================================
model PowerRecord {
  id         String   @id @default(cuid())
  recordDate DateTime @db.Date

  meterId Int
  meter   PowerMeter @relation(fields: [meterId], references: [id])

  isReset Boolean @default(false)

  // ---> CỜ PHÂN BIỆT NGUỒN DỮ LIỆU
  dataSource String @default("MANUAL") // "AUTO" hoặc "MANUAL"

  prevTotal Float?
  currTotal Float?
  consTotal Float?

  prevNormal Float?
  currNormal Float?
  consNormal Float?

  prevPeak Float?
  currPeak Float?
  consPeak Float?

  prevOffPeak Float?
  currOffPeak Float?
  consOffPeak Float?

  costTotal Float?  @default(0)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recordDate, meterId])
  @@map("power_records")
}

// ==========================================
// MODULE SO DO LINE SAN XUAT (Production Line Routing)
// ==========================================
model ProductionLine {
  id   Int    @id @default(autoincrement())
  name String // Ten line (VD: "Line CVC30 - NM1")

  // Mat hang dang chay tren line nay
  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  // Thuoc nha may nao
  factoryId Int
  factory   Factory @relation(fields: [factoryId], references: [id])

  // Loai tuyen: 1 = Khong chai ky, 2 = Co chai ky
  routeType Int @default(1)

  // Thoi gian hieu luc (Luu theo dot)
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date // null = dang hieu luc

  // Ai tao
  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quan he: 1 line co nhieu lien ket may
  links ProductionLineLink[]

  @@index([factoryId])
  @@index([itemId])
  @@index([startDate])
  @@map("production_lines")
}

// 2. Bang chi tiet: Luu tung lien ket may-sang-may
model ProductionLineLink {
  id Int @id @default(autoincrement())

  // Thuoc line nao
  lineId Int
  line   ProductionLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  // May nguon (VD: Chai Tho 01)
  fromMachineId Int
  fromMachine   Machine @relation("LinkFrom", fields: [fromMachineId], references: [id])

  // May dich (VD: Ghep A1)
  toMachineId Int
  toMachine   Machine @relation("LinkTo", fields: [toMachineId], references: [id])

  // Thu tu cong doan (1 = Chai Tho->Ghep, 2 = Ghep A->Ghep B, ...)
  stepOrder Int

  @@unique([lineId, fromMachineId, toMachineId]) // Khong trung lien ket trong 1 line
  @@index([lineId])
  @@index([fromMachineId])
  @@index([toMachineId])
  @@map("production_line_links")
}

// ==========================================
// MODULE GHI NHẬN DỪNG MÁY / SỰ CỐ
// ==========================================

// 1. Danh mục nguyên nhân dừng máy
model StopCategory {
  id        Int     @id @default(autoincrement())
  name      String // Vd: "Hỏng máy", "Thiếu nguyên liệu"
  color     String  @default("#ff4d4f") // Màu hex cho biểu đồ/tag
  isActive  Boolean @default(true)
  isDefault Boolean @default(false) // Dữ liệu seed = true, không được xóa

  createdAt DateTime @default(now())

  stopLogs MachineStopLog[]

  @@map("stop_categories")
}

// 2. Ghi nhận dừng máy
model MachineStopLog {
  id Int @id @default(autoincrement())

  // Máy nào dừng
  machineId Int
  machine   Machine @relation(fields: [machineId], references: [id])

  // Nguyên nhân
  categoryId Int
  category   StopCategory @relation(fields: [categoryId], references: [id])

  // Thời gian
  startTime       DateTime // Lúc máy dừng
  endTime         DateTime? // Lúc máy chạy lại (null = vẫn đang dừng)
  durationMinutes Int? // Tự tính: khoảng cách phút

  // Chi tiết
  description String? // Mô tả thêm
  severity    String  @default("medium") // low, medium, high, critical

  // Ngữ cảnh
  recordDate DateTime @db.Date // Ngày xảy ra
  shift      Int? // Ca làm việc (1, 2, 3)

  // Người báo cáo
  reportedById Int
  reportedBy   User @relation(fields: [reportedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId])
  @@index([recordDate])
  @@index([categoryId])
  @@map("machine_stop_logs")
}

// ==========================================
// MODULE IMPORT IOT EXCEL
// ==========================================

// Định dạng file mà nguồn IoT xuất ra
enum IotFileFormat {
  STANDARD // File XLS/XLSX thông thường: có cột Ngày, Ca, Máy, Mặt hàng, Sản lượng
  DANH_ONG // File HTML-as-XLS của máy đánh ống: ngày+ca trong <div>, cột A=Lô, B=Số máy, M=PRKG
}

// Nguồn IoT — mỗi phần mềm IoT là 1 source
model IotSource {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String?
  fileFormat  IotFileFormat @default(STANDARD)
  // Mapping tên ca: lưu dạng JSON key-value
  // VD: {"Ca sáng":1, "Shift A":1, "Ca chiều":2, "Ca đêm":3}
  shiftMap    Json          @default("{}")
  // Danh sách tên mặt hàng IoT cần bỏ qua, không import
  // VD: ["Dao soi", "Dao", "TEST"]
  skipItems   Json          @default("[]")
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  machineMaps IotMachineMap[]
  itemMaps    IotItemMap[]
  importLogs  IotImportLog[]

  @@map("iot_sources")
}

// Mapping tên máy: tên bên IoT ↔ machineId bên ERP
model IotMachineMap {
  id        Int       @id @default(autoincrement())
  sourceId  Int
  source    IotSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  iotName   String
  machineId Int
  machine   Machine   @relation(fields: [machineId], references: [id])
  createdAt DateTime  @default(now())

  @@unique([sourceId, iotName])
  @@index([sourceId])
  @@map("iot_machine_maps")
}

// Mapping tên mặt hàng: tên bên IoT ↔ itemId bên ERP
model IotItemMap {
  id        Int       @id @default(autoincrement())
  sourceId  Int
  source    IotSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  iotName   String
  itemId    Int
  item      Item      @relation(fields: [itemId], references: [id])
  createdAt DateTime  @default(now())

  @@unique([sourceId, iotName])
  @@index([sourceId])
  @@map("iot_item_maps")
}

// Lịch sử mỗi lần import
model IotImportLog {
  id           Int       @id @default(autoincrement())
  sourceId     Int
  source       IotSource @relation(fields: [sourceId], references: [id])
  fileName     String
  totalRows    Int       @default(0)
  insertedRows Int       @default(0)
  updatedRows  Int       @default(0)
  skippedRows  Int       @default(0)
  errorRows    Int       @default(0)
  status       String // "SUCCESS" | "PARTIAL" | "FAILED"
  errorDetail  Json?
  importedById Int?
  importedAt   DateTime  @default(now())

  @@index([sourceId])
  @@map("iot_import_logs")
}

// ==========================================
// DANH MỤC CA LÀM VIỆC (Shift Category)
// ==========================================

model ShiftCategory {
  code String  @id // Mã ca (VD: CA1, CA2) — do user nhập thủ công
  name String  @unique // Tên ca (VD: Ca sáng, Ca chiều) — không được trùng
  note String? // Ghi chú (tùy chọn)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shift_categories")
}

// ==========================================
// DANH MỤC LOẠI ĐIỆN NĂNG (Energy Type Category)
// ==========================================

model EnergyTypeCategory {
  code String  @id // Mã loại điện (VD: DL, MT) — do user nhập thủ công
  name String  @unique // Tên loại điện (VD: Điện lực, Điện mặt trời) — không được trùng
  note String? // Ghi chú (tùy chọn)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("energy_type_categories")
}

// ==========================================
// DANH MỤC NHÓM ĐỒNG HỒ ĐIỆN (Meter Group Category)
// ==========================================

model MeterGroupCategory {
  id        Int     @id @default(autoincrement())
  groupCode String  @unique // Mã nhóm (VD: MG01, HT-NM1)
  groupName String  @unique // Tên nhóm (VD: Hạ thế Nhà máy 1)
  note      String? // Ghi chú (tùy chọn)

  powerMeters PowerMeter[] // Quan hệ ngược: nhóm này chứa những đồng hồ nào

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meter_group_categories")
}

// ==========================================
// MODULE KD-SX (KẾ HOẠCH KINH DOANH SẢN XUẤT)
// ==========================================

// --- Enums ---

enum BenchmarkType {
  THEORY // Định mức lý thuyết — tính từ công thức vật lý
  EMPIRICAL // Định mức thực nghiệm — nhập tay từ kinh nghiệm
}

enum PlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum FixedCostType {
  TIEN_LUONG // Chi phí tiền lương
  TRICH_TRUOC_LUONG // Trích trước tiền lương
  TIEN_AN_CA // Tiền ăn ca
  BHXH_YT_TN_KPCD // BHXH, YT, TN, KPCĐ
  TIEN_DIEN // Tiền điện
  KHAU_HAO // Khấu hao
  ONG_CONE_BAO_PP // Ống cone, thùng CT, bao PP...
  CHI_PHI_VAT_LIEU // CP vật liệu + CP khác
  CHI_PHI_QUAN_LY // CP quản lý doanh nghiệp
  LAI_VAY_VCD // Lãi vay vốn cố định
  LAI_VAY_VLD // Lãi vay vốn lưu động
  LO_CHENH_LECH_TY_GIA // Lỗ chênh lệch tỷ giá
  DOANH_THU_HDTC // Doanh thu hoạt động tài chính (cộng vào lợi nhuận)
  KHAC // Khác
}

enum SnapshotType {
  KH // Kế hoạch
  TH // Thực hiện
}

enum CustomerType {
  DOMESTIC // Khách hàng trong nước
  FOREIGN // Khách hàng nước ngoài
}

enum OrderStatus {
  ACTIVE
  DONE
  OVERDUE
  CANCELLED
}

// --- Nhóm Hợp đồng ---

// 1. Danh mục khách hàng
model Customer {
  id           Int          @id @default(autoincrement())
  name         String // Tên khách hàng
  code         String?      @unique // Mã KH (nếu có)
  address      String? // Địa chỉ
  phone        String? // Số điện thoại
  email        String? // Email
  taxCode      String? // Mã số thuế
  customerType CustomerType @default(DOMESTIC) // Trong nước / Nước ngoài
  note         String?

  salesOrders SalesOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

// 2. Hợp đồng bán hàng
model SalesOrder {
  id      Int    @id @default(autoincrement())
  orderNo String @unique // Số HĐ: "431PB25", "05PB26", "14/HĐMB-PB26"

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  factoryId Int
  factory   Factory @relation(fields: [factoryId], references: [id])

  signedDate    DateTime?   @db.Date
  deliveryDate  DateTime    @db.Date
  status        OrderStatus @default(ACTIVE)
  startDate     DateTime?   @db.Date
  completedDate DateTime?   @db.Date
  note          String?
  isActive      Boolean     @default(true)

  items SalesOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factoryId])
  @@index([customerId])
  @@map("sales_orders")
}

// 3. Chi tiết hợp đồng (từng loại sợi + số lượng + đơn giá)
model SalesOrderItem {
  id      Int        @id @default(autoincrement())
  orderId Int
  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  plannedQty      Float // Số lượng HĐ (kg)
  unitPrice       Float // Đơn giá (USD/kg)
  sellingCostRate Float? // Hệ số CP bán hàng (VD: 0.08 = 8%)
  deliveredQty    Float     @default(0) // Số lượng đã giao TRƯỚC khi dùng phần mềm (kg)
  deliveryDate    DateTime? @db.Date // deadline riêng nếu khác HĐ
  allocatedQty    Float     @default(0) // cached, cập nhật tự động
  priorityOverride  Int?      // Ưu tiên thủ công: số nhỏ = ưu tiên cao. NULL = tự động theo deadline/signDate
  deferToMonth      String?   // "YYYY-MM" — hoãn HĐ đến tháng này. NULL = active ngay
  wasteRecoveryRate Float?    // Tỷ lệ phế thu hồi (0.0–1.0, VD: 0.07 = 7% unitPrice). Per-contract override
  doubleTwistGcRate Float?   // CP GC sợi xe đôi (0.0–1.0, VD: 0.05 = 5% unitPrice). Chỉ sợi /2
  note            String?

  planLineItems   PlanLineItem[]
  actualLineItems ActualLineItem[]
  allocations     OrderAllocation[]
  quotas          MonthlyQuota[]
  openingBalances ContractOpeningBalance[]

  // Lot management
  lots Lot[]

  @@index([orderId])
  @@index([itemId])
  @@map("sales_order_items")
}

/// Phân bổ quota sản lượng cho từng dòng HĐ trong tháng.
/// Phòng KD nhập đầu mỗi tháng, quyết định rót bao nhiêu cho HĐ nào.
model MonthlyQuota {
  id               Int    @id @default(autoincrement())
  salesOrderItemId Int
  factoryId        Int    // scope: nhà máy
  processId        Int    // scope: công đoạn (ống / sợi con tách biệt)
  yearMonth        String @db.VarChar(7) // "2026-05"

  /// Số kg tối đa rót cho dòng HĐ này trong tháng.
  /// NULL khi isRemainder=true (tự tính = tổng SL item - tổng FIXED)
  quotaQty    Float?

  /// true = HĐ cuối cùng nhận phần dư. Mỗi item+yearMonth chỉ có 1 REMAINDER.
  isRemainder Boolean @default(false)

  /// Thứ tự rót trong waterfall (số nhỏ = rót trước). Chỉ dùng cho FIXED.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  factory        Factory        @relation(fields: [factoryId], references: [id])
  process        Process        @relation(fields: [processId], references: [id])

  @@unique([salesOrderItemId, factoryId, processId, yearMonth])
  @@index([factoryId, processId, yearMonth])
  @@map("monthly_quotas")
}

/// Số dư đầu kỳ cho từng dòng HĐ khi bắt đầu áp dụng phân bổ quota theo tháng.
/// Dùng để tách quá khứ chuyển đổi khỏi logic rót ProductionLog/MonthlyQuota từ kỳ mới.
model ContractOpeningBalance {
  id               Int    @id @default(autoincrement())
  salesOrderItemId Int
  factoryId        Int
  processId        Int
  openingYearMonth String @db.VarChar(7) // "2026-06"

  /// Sản lượng đã SX/giao/tính trước kỳ mở sổ phần mềm (kg).
  producedBeforeKg Float @default(0)
  note             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  factory        Factory        @relation(fields: [factoryId], references: [id])
  process        Process        @relation(fields: [processId], references: [id])

  @@unique([salesOrderItemId, factoryId, processId, openingYearMonth], map: "opening_balance_soi_factory_process_month")
  @@index([factoryId, processId, openingYearMonth])
  @@map("contract_opening_balances")
}

// --- Nhóm Thông số tháng ---

// 4. Thông số đầu vào tháng (giá NVL, tỷ giá, tỷ lệ phối trộn)
model MonthlyInputParam {
  id        Int     @id @default(autoincrement())
  factoryId Int
  factory   Factory @relation(fields: [factoryId], references: [id])
  yearMonth String // "2026-01"

  // Tỷ giá (VNĐ/USD)
  exchangeRate Float

  // Giá nguyên liệu (USD/kg)
  cottonUsaPrice      Float?
  cottonBrazilPrice   Float?
  cottonAusPrice      Float?
  cottonPimaPrice     Float?
  cottonSupimaPrice   Float?
  cottonCmiaPrice     Float?
  peBenmaPrice        Float?
  lenzingViscosePrice Float?
  livaEcoPrice        Float?

  // Tỷ lệ phối trộn bông (0.0–1.0)
  cottonUsaRatio    Float?
  cottonBrazilRatio Float?
  cottonAusRatio    Float?

  // Phí về kho (USD/kg) — thường 0.02
  warehouseFee Float? @default(0.02)

  // Giá bông bình quân tính toán (USD/kg) — lưu snapshot
  avgCottonPrice Float?

  // Giá phế liệu (VNĐ/kg)
  wastePrice Float?

  wasteAdjustmentFactor Float? @default(0.95) // Hệ số điều chỉnh phế thu hồi (0.95, 0.92...). Thay đổi theo tháng.

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([factoryId, yearMonth])
  @@index([factoryId])
  @@map("monthly_input_params")
}

// 5. Định mức tiêu hao nguyên liệu (có lịch sử theo Item)
model RawMaterialRate {
  id     Int  @id @default(autoincrement())
  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  // Định mức Cotton (kg NVL / kg thành phẩm)
  cottonRate Float?

  // Định mức PE (kg NVL / kg TP) — giá trị GỐC (VD: 1.02), code tự nhân peRatio khi tính
  peRate Float?

  // Tỷ lệ cotton (0-1). VD: 1.0=100% cotton, 0.6=60% cotton
  // peRatio = 1 - cottonRatio, không cần lưu
  cottonRatio Float @default(1.0)

  /// @deprecated — v2 không dùng. Đã chuyển sang SalesOrderItem.wasteRecoveryRate
  wasteRate Float?

  /// @deprecated — v2 không dùng. Đã chuyển sang SalesOrderItem.doubleTwistGcRate
  doubleTwistGcRate Float?

  // Thời gian hiệu lực
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date // null = đang hiệu lực

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([effectiveFrom])
  @@map("raw_material_rates")
}

// --- Nhóm Kế hoạch (KH) ---

/// @deprecated v2 — không dùng. Giữ DB để backward compat, không tham chiếu trong code mới.
model MonthlyPlan {
  id        Int        @id @default(autoincrement())
  factoryId Int
  factory   Factory    @relation(fields: [factoryId], references: [id])
  yearMonth String // "2026-01"
  status    PlanStatus @default(DRAFT)
  note      String?

  lineItems  PlanLineItem[]
  fixedCosts FixedCostEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([factoryId, yearMonth])
  @@index([factoryId])
  @@map("monthly_plans")
}

/// @deprecated v2 — không dùng. Giữ DB để backward compat, không tham chiếu trong code mới.
model PlanLineItem {
  id     Int         @id @default(autoincrement())
  planId Int
  plan   MonthlyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  salesOrderItemId Int?
  salesOrderItem   SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])

  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  qty          Float // Số lượng kế hoạch (kg)
  unitPriceUsd Float // Đơn giá (USD/kg)

  // Snapshot loại NVL + giá tại thời điểm tạo — KHÔNG thay đổi dù giá tháng sau đổi
  cottonMaterialTypeId Int? // Loại bông đã chọn (FK → MaterialType)
  cottonPriceUsd       Float? // Snapshot giá bông (USD/kg) lúc tạo
  cottonRatio          Float? // Snapshot tỷ lệ cotton (0-1)
  peMaterialTypeId     Int? // Loại PE đã chọn (null nếu 100% cotton)
  pePriceUsd           Float? // Snapshot giá PE (USD/kg) lúc tạo
  peRatio              Float? // Snapshot tỷ lệ PE (= 1 - cottonRatio)

  // Snapshot giá trị tính toán tại thời điểm tạo — KHÔNG tính lại on-the-fly
  revenueVnd       Float? // Doanh thu (VNĐ)
  cottonCostVnd    Float? // CP NVL Cotton (VNĐ)
  peCostVnd        Float? // CP NVL PE (VNĐ)
  sellingCostVnd   Float? // CP Bán hàng (VNĐ)
  gcDoubleTwistVnd Float? // CP GC sợi xe đôi (VNĐ)
  wasteRecoveryVnd Float? // Phế thu hồi (VNĐ) — giá trị dương, trừ vào chi phí
  grossProfitVnd   Float? // Lợi nhuận gộp (VNĐ)

  isAutoQty Boolean @default(false) // true = tự tính SL còn lại = tổng SL mặt hàng − các HĐ khác

  note String?

  @@index([planId])
  @@index([itemId])
  @@map("plan_line_items")
}

// 8. Chi phí cố định — dùng chung cho KH và TH, phân biệt qua FK
model FixedCostEntry {
  id       Int           @id @default(autoincrement())
  costType FixedCostType

  // Đúng 1 trong 2 FK phải có giá trị (validate ở service layer)
  monthlyPlanId   Int?
  monthlyPlan     MonthlyPlan?   @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  monthlyActualId Int?
  monthlyActual   MonthlyActual? @relation(fields: [monthlyActualId], references: [id], onDelete: Cascade)

  factoryId  Int      // FK → Factory
  yearMonth  String   // "YYYY-MM"
  factory    Factory  @relation(fields: [factoryId], references: [id])

  amountVnd Float // Số tiền (VNĐ)
  note      String?

  @@index([monthlyPlanId])
  @@index([monthlyActualId])
  @@unique([factoryId, yearMonth, costType], map: "fixed_cost_factory_month_type")
  @@map("fixed_cost_entries")
}

// --- Nhóm Thực hiện (TH) ---

/// @deprecated v2 — không dùng. Giữ DB để backward compat, không tham chiếu trong code mới.
model MonthlyActual {
  id        Int     @id @default(autoincrement())
  factoryId Int
  factory   Factory @relation(fields: [factoryId], references: [id])
  yearMonth String // "2026-01"
  note      String?

  lineItems  ActualLineItem[]
  fixedCosts FixedCostEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([factoryId, yearMonth])
  @@index([factoryId])
  @@map("monthly_actuals")
}

/// @deprecated v2 — không dùng. Giữ DB để backward compat, không tham chiếu trong code mới.
model ActualLineItem {
  id       Int           @id @default(autoincrement())
  actualId Int
  actual   MonthlyActual @relation(fields: [actualId], references: [id], onDelete: Cascade)

  salesOrderItemId Int?
  salesOrderItem   SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])

  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  qty          Float // Sản lượng thực (kg) — tổng hợp từ ProductionLog
  unitPriceUsd Float // Đơn giá thực tế (USD/kg)

  // Snapshot loại NVL + giá tại thời điểm sync
  cottonMaterialTypeId Int?
  cottonPriceUsd       Float?
  cottonRatio          Float?
  peMaterialTypeId     Int?
  pePriceUsd           Float?
  peRatio              Float?

  // Snapshot giá trị tính toán tại thời điểm tạo
  revenueVnd       Float?
  cottonCostVnd    Float?
  peCostVnd        Float?
  sellingCostVnd   Float?
  gcDoubleTwistVnd Float?
  wasteRecoveryVnd Float?
  grossProfitVnd   Float?

  isAutoQty Boolean @default(false) // true = SL tự tính từ KH, không nhập tay
  isAdHoc   Boolean @default(false) // true = HĐ phát sinh, không có trong KH

  note String?

  @@index([actualId])
  @@index([itemId])
  @@map("actual_line_items")
}

// ==========================================
// MODULE ĐỊNH MỨC NĂNG SUẤT
// ==========================================

// Phiên bản định mức — mỗi lần kỹ thuật cập nhật tạo 1 version mới
model BenchmarkVersion {
  id            Int       @id @default(autoincrement())
  versionName   String // "v1.0 - 2026", "v1.1 - Sau cải tiến tháng 3"
  factoryId     Int
  factory       Factory   @relation(fields: [factoryId], references: [id])
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date // null = đang hiệu lực
  approvedBy    String? // tên người duyệt
  note          String? // lý do cập nhật
  isActive      Boolean   @default(true)

  benchmarks ProductivityBenchmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factoryId])
  @@index([effectiveFrom])
  @@map("benchmark_versions")
}

// Định mức từng mặt hàng trên từng công đoạn
model ProductivityBenchmark {
  id        Int              @id @default(autoincrement())
  versionId Int
  version   BenchmarkVersion @relation(fields: [versionId], references: [id])

  // Liên kết với danh mục hiện có
  itemId    Int
  item      Item    @relation(fields: [itemId], references: [id])
  processId Int
  process   Process @relation(fields: [processId], references: [id])

  // Thông tin loại máy (không phải máy cụ thể — là loại máy trong công đoạn đó)
  machineModel String // "G32", "Murata Qpro-EX", "Rieter RSB-D50"
  speedUnit    String // "rpm" (vòng/phút) hoặc "mpm" (m/phút)

  // Thông số kỹ thuật đầu vào
  nm                 Float // chỉ số Nm
  ne                 Float // chỉ số Ne
  twist              Float? // độ săn (x/m) — null với máy ghép/ống
  speedValue         Float // tốc độ (v/p hoặc m/p)
  spindleOrHeadCount Int? // số cọc (máy sợi con) hoặc số đầu ra (máy ghép)

  // Kết quả tính toán — lưu snapshot
  theoreticalOutput Float // NS lý thuyết (kg/ca) — tính từ công thức
  efficiency        Float // hiệu suất chuẩn (0.80 – 0.95)
  stdOutputPerShift Float // ĐỊNH MỨC = theoreticalOutput × efficiency (kg/ca/máy)

  note String? // ghi chú kỹ thuật

  // --- THÊM MỚI: Định mức thực nghiệm (EMPIRICAL) ---
  // Strictly additive — không ảnh hưởng rows cũ (default THEORY)
  benchmarkType         BenchmarkType @default(THEORY) // loại định mức
  empiricalOutputPerDay Float? // kg/ngày (3 ca) — chỉ dùng khi EMPIRICAL
  empiricalNote         String? // nguồn số liệu thực nghiệm

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([versionId, itemId, processId, machineModel])
  @@index([versionId])
  @@index([itemId])
  @@index([processId])
  @@map("productivity_benchmarks")
}

// ==========================================
// MODULE THEO DÕI ĐƠN HÀNG — Allocation
// ==========================================

model OrderAllocation {
  id               Int            @id @default(autoincrement())
  salesOrderItemId Int
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  productionDate   DateTime       @db.Date
  factoryId        Int
  itemId           Int
  allocatedQty     Float
  allocationDate   DateTime       @default(now())

  // Phân biệt nguồn allocation: "PRODUCTION" (công nhân) hoặc "KD" (phòng kinh doanh)
  source String @default("PRODUCTION")

  @@index([salesOrderItemId])
  @@index([productionDate, factoryId, itemId])
  @@map("order_allocations")
}

// ==========================================
// MODULE KD DAILY INPUT — Nhập sản lượng ngày (Phòng KD)
// ==========================================

model KdDailyInput {
  id          Int      @id @default(autoincrement())
  machineId   Int
  machine     Machine  @relation(fields: [machineId], references: [id])
  itemId      Int
  item        Item     @relation(fields: [itemId], references: [id])
  lotId       Int?     // Lô sợi đang SX (từ MachineItemAssignment.lotId cho máy multi-item)
  lot         Lot?     @relation(fields: [lotId], references: [id])
  recordDate  DateTime @db.Date
  outputKg    Float // sản lượng cả ngày (3 ca gộp) — KD tự tổng hợp
  note        String?
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 1 máy + 1 mặt hàng + 1 ngày = 1 dòng duy nhất
  // Máy chạy 2 mặt hàng → 2 dòng riêng
  @@unique([machineId, itemId, recordDate])
  @@index([recordDate])
  @@index([machineId])
  @@index([itemId])
  @@map("kd_daily_inputs")
}

// --- Dashboard Cache ---

/// @deprecated v2 — không dùng. Giữ DB để backward compat, không tham chiếu trong code mới.
model MonthlySummarySnapshot {
  id        Int          @id @default(autoincrement())
  factoryId Int
  factory   Factory      @relation(fields: [factoryId], references: [id])
  yearMonth String // "2026-01"
  type      SnapshotType // KH hoặc TH

  // Tổng hợp
  totalQtyKg      Float? // Tổng sản lượng (kg)
  totalRevenueVnd Float? // Tổng doanh thu (VNĐ)
  totalCostVnd    Float? // Tổng chi phí (VNĐ)
  totalProfitVnd  Float? // Tổng lợi nhuận (VNĐ)

  refreshedAt DateTime @default(now()) @updatedAt

  @@unique([factoryId, yearMonth, type])
  @@index([factoryId])
  @@map("monthly_summary_snapshots")
}

// ==========================================
// MODULE PHÂN QUYỀN THEO TRANG (Page-Level Permissions)
// ==========================================

// Danh mục các trang trong hệ thống — seed khi khởi tạo
model PageRegistry {
  id        Int    @id @default(autoincrement())
  pageKey   String @unique // VD: "production.daily-input", "kdsx.plans"
  pageName  String // VD: "Nhập sản lượng", "Kế hoạch tháng"
  pageGroup String // VD: "SẢN XUẤT", "KINH DOANH", "ĐIỆN NĂNG"
  path      String // VD: "/production/daily-input"
  sortOrder Int    @default(0) // Thứ tự hiển thị trong bảng quản lý

  permissions PagePermission[]

  @@map("page_registry")
}

// Bảng phân quyền: User <-> Page (nhiều-nhiều) với 2 cờ VIEW/EDIT
model PagePermission {
  id     Int          @id @default(autoincrement())
  userId Int
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId Int
  page   PageRegistry @relation(fields: [pageId], references: [id], onDelete: Cascade)

  canView Boolean @default(true) // Được xem trang này?
  canEdit Boolean @default(false) // Được chỉnh sửa trên trang này?

  @@unique([userId, pageId])
  @@index([userId])
  @@map("page_permissions")
}

// ==========================================
// MODULE KẾ HOẠCH SẢN XUẤT THÁNG
// ==========================================

// Bảng chính: 1 kế hoạch = 1 nhà máy × 1 tháng
model ProductionSchedule {
  id        Int        @id @default(autoincrement())
  factoryId Int
  factory   Factory    @relation(fields: [factoryId], references: [id])
  yearMonth String // "2026-04"
  name      String     @default("") // Tên kế hoạch do user đặt (VD: "KH sợi ống T5")
  isPrimary Boolean    @default(false) // Schedule chính được dùng cho TH-Sản lượng Dashboard
  status    PlanStatus @default(DRAFT) // tái dùng enum PlanStatus sẵn có
  note      String?

  // Các ngày nghỉ trong tháng: lưu JSON array các số ngày
  // VD: [30] = ngày 30 nghỉ; [1, 2, 30] = ngày 1, 2, 30 nghỉ
  holidays Json @default("[]")

  // Bảng màu per-item trong schedule này: {"1":"#4CAF50","5":"#2196F3",...}
  itemColors Json @default("{}")

  processId Int?    // Công đoạn. Mỗi (factory, process, yearMonth) = 1 schedule
  process   Process? @relation(fields: [processId], references: [id])

  segments ScheduleSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([factoryId, yearMonth, name])
  @@index([factoryId])
  @@map("production_schedules")
}

// Chi tiết: mỗi segment = 1 máy chạy 1 mặt hàng trong 1 khoảng ngày
// 1 máy đổi mặt hàng giữa tháng → nhiều segments (cùng machineId, itemId khác nhau)
model ScheduleSegment {
  id         Int                @id @default(autoincrement())
  scheduleId Int
  schedule   ProductionSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  machineId Int
  machine   Machine @relation(fields: [machineId], references: [id])

  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  fromDay  Int // 1–31: ngày bắt đầu trong tháng
  toDay    Int // 1–31: ngày kết thúc (bao gồm)
  kgPerDay Float // Sản lượng kg/ngày (auto-fill từ empiricalOutputPerDay hoặc user sửa)

  // Lưu metadata để biết auto-fill từ đâu (optional, cho audit)
  benchmarkId Int? // ProductivityBenchmark.id được dùng để auto-fill
  isManualKg  Boolean @default(false) // true nếu user sửa kg/ngày khác với định mức

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
  @@index([machineId])
  @@index([itemId])
  @@map("schedule_segments")
}

// ==========================================
// MODULE DANH MỤC NGUYÊN VẬT LIỆU
// ==========================================

// Danh mục loại nguyên vật liệu (bông, PE, viscose...)
// Admin quản lý — thêm/sửa/xóa không cần sửa code
model MaterialType {
  id       Int     @id @default(autoincrement())
  code     String  @unique // "AUS", "US_PVC", "BRA", "PE_INDO"...
  name     String // "Bông Úc", "Bông Mỹ PVC", "PE Benma Indo"...
  category String // "COTTON" hoặc "PE" — phân loại để filter
  isActive Boolean @default(true)
  note     String?

  prices MaterialPrice[]

  // Cơ cấu NVL theo tháng — 1 MaterialType được tham chiếu 2 lần (cotton + pe)
  itemMonthlyCotton ItemMonthlyMaterial[] @relation("ItemMonthlyCotton")
  itemMonthlyPe     ItemMonthlyMaterial[] @relation("ItemMonthlyPe")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("material_types")
}

/// Cơ cấu NVL của mặt hàng theo tháng.
/// Mỗi đầu tháng kế toán chọn: mặt hàng X tháng này dùng loại bông nào, xơ nào.
/// Calculator query đúng MaterialPrice theo lựa chọn này.
model ItemMonthlyMaterial {
  id        Int    @id @default(autoincrement())
  itemId    Int
  yearMonth String @db.VarChar(7) // "2026-05"

  /// Loại bông dùng (Cotton AUS, US-PVC, Brazil...). NULL nếu không dùng cotton (hiếm).
  cottonMaterialTypeId Int?
  /// Loại xơ nhân tạo (PE Benma, Modal Liva Eco...). NULL nếu sợi thuần cotton.
  peMaterialTypeId Int?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item               Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cottonMaterialType MaterialType? @relation("ItemMonthlyCotton", fields: [cottonMaterialTypeId], references: [id])
  peMaterialType     MaterialType? @relation("ItemMonthlyPe", fields: [peMaterialTypeId], references: [id])

  @@unique([itemId, yearMonth])
  @@index([yearMonth])
  @@map("item_monthly_materials")
}

// Giá nguyên vật liệu theo tháng
// Kế toán nhập đầu mỗi tháng
model MaterialPrice {
  id             Int          @id @default(autoincrement())
  materialTypeId Int
  materialType   MaterialType @relation(fields: [materialTypeId], references: [id])
  yearMonth      String // "2026-04"
  priceUsd       Float // Giá USD/kg

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialTypeId, yearMonth])
  @@index([materialTypeId])
  @@index([yearMonth])
  @@map("material_prices")
}

// ==========================================
// MODEL: PHÂN CÔNG MẶT HÀNG CHO MÁY ỐNG MULTI-ITEM
// ==========================================
model MachineItemAssignment {
  id        Int     @id @default(autoincrement())
  machineId Int
  machine   Machine @relation(fields: [machineId], references: [id])
  itemId    Int
  item      Item    @relation(fields: [itemId], references: [id])
  lotId     Int?                                                          // Lô sợi đang chạy cho mặt hàng này
  lot       Lot?    @relation(fields: [lotId], references: [id])          // Quan hệ tới Lot

  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique constraint cũ [machineId, itemId] đã được thay bằng 2 partial unique index
  // (xem migration shift_item_change_multi_lot):
  //   - machine_assignment_unique_with_lot: (machineId, itemId, lotId) WHERE lotId IS NOT NULL
  //   - machine_assignment_unique_no_lot:   (machineId, itemId)        WHERE lotId IS NULL
  // Cho phép 1 máy chạy cùng 1 mặt hàng từ 2 lô khác nhau.
  @@index([machineId])
  @@map("machine_item_assignments")
}

// ==========================================
// MODULE QUẢN LÝ LÔ HÀNG (Lot Management)
// ==========================================

model Lot {
  id        Int     @id @default(autoincrement())
  lotNumber String // Người dùng tự đặt, VD: "B2026-05-001", text tự do
  lotType   LotType // RAW_COTTON / RAW_FIBER / YARN

  // Mặt hàng — bắt buộc với YARN, optional với NL
  itemId Int?
  item   Item? @relation(fields: [itemId], references: [id])

  // Nhà máy
  factoryId Int
  factory   Factory @relation(fields: [factoryId], references: [id])

  // Gắn với HĐ (chỉ YARN, optional)
  salesOrderItemId Int?
  salesOrderItem   SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])

  status LotStatus @default(OPEN)
  note   String?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  // Relations — truy xuất NL
  rawMaterials LotMaterialLink[] @relation("YarnLot") // Lô sợi này dùng NL từ lô nào
  usedInYarns  LotMaterialLink[] @relation("RawLot") // Lô NL này được dùng cho lô sợi nào

  // Relations — dữ liệu SX
  productionLogs ProductionLog[]

  // Máy đang chạy lô này
  runningOnMachines Machine[] @relation("CurrentLot")

  // Quan hệ ngược: MachineItemAssignment dùng lô này
  machineAssignments MachineItemAssignment[]

  // KD daily input dùng lô này
  kdDailyInputs KdDailyInput[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lotType])
  @@index([factoryId])
  @@index([itemId])
  @@index([lotNumber])
  @@map("lots")
}

// Link lô sợi ↔ lô nguyên liệu (many-to-many)
// 1 lô sợi có thể dùng nhiều lô bông + tối đa 1 lô xơ
model LotMaterialLink {
  id        Int     @id @default(autoincrement())
  yarnLotId Int
  yarnLot   Lot     @relation("YarnLot", fields: [yarnLotId], references: [id])
  rawLotId  Int
  rawLot    Lot     @relation("RawLot", fields: [rawLotId], references: [id])
  note      String?

  @@unique([yarnLotId, rawLotId])
  @@index([yarnLotId])
  @@index([rawLotId])
  @@map("lot_material_links")
}
